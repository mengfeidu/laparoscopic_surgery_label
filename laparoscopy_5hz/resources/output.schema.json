{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One core: laparoscopic evidence-based annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewed_start_frame", "reviewed_end_frame", "scene_summary_zh", "events", "uncertain_ranges", "key_events"],
  "properties": {
    "reviewed_start_frame": {"type": "integer", "minimum": 0},
    "reviewed_end_frame": {"type": "integer", "minimum": 1},
    "scene_summary_zh": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_frame", "end_frame", "instrument_code", "tool_position", "tool_description_zh", "action_code", "target_code", "target_detail_zh", "target_certainty", "mediator", "result_zh", "evidence_zh", "confidence"],
        "properties": {
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "instrument_code": {"type": "string"},
          "tool_position": {"type": "string"},
          "tool_description_zh": {"type": "string", "minLength": 1},
          "action_code": {"type": "string"},
          "target_code": {"type": "string"},
          "target_detail_zh": {"type": "string", "minLength": 1},
          "target_certainty": {"type": "string"},
          "mediator": {"type": "string"},
          "result_zh": {"type": "string", "minLength": 1},
          "evidence_zh": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "uncertain_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_frame", "end_frame", "reason_zh"],
        "properties": {
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "reason_zh": {"type": "string", "minLength": 1}
        }
      }
    },
    "key_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "kind", "description_zh"],
        "properties": {
          "frame": {"type": "integer", "minimum": 0},
          "kind": {"type": "string"},
          "description_zh": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
